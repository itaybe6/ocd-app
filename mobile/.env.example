# Expo Push / EAS — required for getExpoPushTokenAsync (see app.config.js).
# Run `npx eas-cli@latest init` in the mobile folder, then copy Project ID from the dashboard or eas.json.
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Shopify Storefront API (required for store + checkout)
# Expo inlines only variables prefixed with EXPO_PUBLIC_ into the JS bundle.
# Use these in .env for local development (e.g. `npx expo start`).

EXPO_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_access_token

# Optional: menu handle for categories (defaults to main-menu). Must be the SAME menu you assign
# in the theme header (Online Store → Themes → Customize → Header), or the app will show different
# subcategories than on the website. List handles under Online Store → Navigation.
# EXPO_PUBLIC_SHOPIFY_MENU_HANDLE=main-menu

# קולקציית «חברות נבחרות» לפי handle מ-Shopify — רצועת סטוריז בדף הבית (נפרד מהבנטו)
# EXPO_PUBLIC_HOME_SELECTED_BRANDS_COLLECTION_HANDLE=your-collection-handle

# --- Aliases (also read by `src/lib/shopify.ts` if set with EXPO_PUBLIC_) ---
# EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# EXPO_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_access_token

# --- OCD+ membership 13% member discount ------------------------------------
# The discount CODE created once in Shopify Admin (Discounts → code, 13% off,
# ideally restricted to customers tagged OCD_PLUS_ACTIVE). The app applies it to
# the cart only for server-verified active members before checkout.
# EXPO_PUBLIC_OCD_PLUS_DISCOUNT_CODE=OCDPLUS13

# --- Non-public names (only work if your build injects them into the client bundle) ---
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_access_token

# --- Pulseem SMS OTP ---------------------------------------------------------
# These are NOT used by the mobile app at runtime (Expo would inline them and
# expose them to all users). They are stored here purely as a single source of
# truth for what must be set in Supabase Edge Functions → Secrets for the
# `auth-phone-otp` function. From the project root run:
#
#   npx supabase login
#   npx supabase link --project-ref wlzreoiumzmfbskzuywj
#   npx supabase secrets set \
#     PULSEEM_MAIN_API_KEY_B64="..." \
#     PULSEEM_FIELD_ENCRYPTION_KEY="..." \
#     PULSEEM_USER_ID="..." \
#     PULSEEM_PASSWORD="..." \
#     PULSEEM_FROM_NUMBER="0508085737"
#
# Optional overrides:
#   PULSEEM_OTP_FROM_NUMBER       sender override for OTP only
#   PULSEEM_REST_FROM_NUMBER      sender override when REST is used
#   AUTH_OTP_DEBUG_RETURN_CODE=1  return the OTP in the response (DEV ONLY)
PULSEEM_MAIN_API_KEY_B64=base64-encoded-pulseem-rest-api-key
PULSEEM_FIELD_ENCRYPTION_KEY=your-pulseem-field-encryption-key
PULSEEM_USER_ID=your-pulseem-account-id
PULSEEM_PASSWORD=your-pulseem-account-password
PULSEEM_FROM_NUMBER=0508085737

# --- OCD+ membership Edge Function secrets ----------------------------------
# Server-only. Set via `npx supabase secrets set ...` — NEVER expose in the app.
#
# Shopify Admin (Custom App token, scopes: read_customers, write_customers) —
# used to find/create the customer and add/remove the OCD_PLUS_ACTIVE tag:
#   SHOPIFY_STORE_DOMAIN="ocdonlinee.myshopify.com"
#   SHOPIFY_ADMIN_API_TOKEN="shpat_..."
#
# Hyp payments (fill in once you have the Hyp merchant docs — see
# supabase/functions/_shared/hyp.ts, which is intentionally stubbed):
#   HYP_API_BASE_URL="..."
#   HYP_MASOF="..."            # terminal / masof number (or HYP_TERMINAL)
#   HYP_API_KEY="..."
#   HYP_CALLBACK_SECRET="..."  # verify server-to-server callbacks
