# Copy to .env.hyp.local (git-ignored); never put these in mobile/ or EXPO_PUBLIC_*.
# Use the separate OCD+ recurring terminal, preserving its leading zeroes.
HYP_MASOF=
HYP_API_KEY=
HYP_PASS_P=
# Leave false until the release requirements in docs/HYP-INTEGRATION.md pass.
HYP_CHECKOUT_ENABLED=false
# Optional live pilot: comma-separated verified customer UUIDs, server-only.
# This permits real charges for those customers while general checkout stays off.
HYP_CHECKOUT_CUSTOMER_IDS=
